<div class="card xnova-panel border-0 shadow-sm mb-3">
	<div class="card-header fw-semibold">
		<i class="bi bi-envelope" aria-hidden="true"></i> {ctc_title}
	</div>
	<div class="card-body">
		<p class="text-body-secondary">{ctc_intro}</p>
		<div class="table-responsive">
			<table class="table table-sm table-hover align-middle mb-0">
				<thead>
					<tr>
						<th scope="col">{ctc_name}</th>
						<th scope="col">{ctc_rank}</th>
						<th scope="col">{ctc_mail}</th>
					</tr>
				</thead>
				<tbody>{ctc_admin_list}</tbody>
			</table>
		</div>
	</div>
</div>
