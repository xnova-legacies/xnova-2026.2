<div class="card xnova-panel border-0 shadow-sm mb-3">
	<div class="card-header fw-semibold">
		<i class="bi bi-slash-circle" aria-hidden="true"></i> {ban_title}
	</div>
	<div class="table-responsive">
		<table class="table table-sm table-hover align-middle mb-0">
			<thead>
				<tr>
					<th scope="col">{ban_name}</th>
					<th scope="col">{ban_reason}</th>
					<th scope="col">{ban_from}</th>
					<th scope="col">{ban_to}</th>
					<th scope="col">{ban_by}</th>
				</tr>
			</thead>
			<tbody>{banned}</tbody>
		</table>
	</div>
</div>
