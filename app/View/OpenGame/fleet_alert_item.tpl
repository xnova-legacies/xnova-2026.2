<span class="xnova-alert-item">
	<span class="badge text-bg-dark">{alert_mission}</span>
	<span class="xnova-alert-route">{alert_from} <span aria-hidden="true">&#8594;</span> {alert_to}</span>
	<span class="xnova-alert-time" data-fleet-alert-end="{alert_end}">
		<span class="xnova-alert-countdown">{alert_countdown}</span>
	</span>
</span>
