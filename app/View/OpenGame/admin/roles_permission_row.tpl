<label class="form-check d-flex align-items-center gap-2 mb-1">
	<input class="form-check-input mt-0" type="checkbox" name="permissions[]" value="{permission_name}"{permission_checked}{permission_disabled}>
	<span class="form-check-label">{permission_label}</span>
	<span class="text-body-secondary small font-monospace">{permission_page}</span>
</label>
