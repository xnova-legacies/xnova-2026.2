<div class="card border-0 shadow-sm mb-3 xnova-battle-forces">
	<div class="card-header py-1 small fw-semibold">{sys_attack_forces_title}</div>
	<div class="table-responsive">
		<table class="table table-sm table-borderless align-middle mb-0">
			<thead>
				<tr class="small text-body-secondary">
					<th scope="col">{sys_attack_force_name}</th>
					<th scope="col">{sys_attack_force_side}</th>
					<th scope="col">{sys_attack_force_engaged}</th>
					<th scope="col">{sys_attack_force_lost}</th>
				</tr>
			</thead>
			<tbody>{forces_rows}</tbody>
		</table>
	</div>
	<p class="card-body py-2 small text-body-secondary mb-0">{sys_attack_forces_hint}</p>
</div>
