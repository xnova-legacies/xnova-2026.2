<div class="card xnova-panel border-0 shadow-sm mb-3" data-xnova-message="1">
    <div class="card-header fs-5 fw-semibold text-bg-{variant}">{title}</div>
    <div class="card-body">
            <p class="mb-0">{mes}</p>
    </div>
    <div class="card-footer d-flex flex-wrap align-items-center justify-content-end gap-2">
        <span class="me-auto small text-body-secondary" data-xnova-message-status></span>
        <button type="button" class="btn btn-sm btn-outline-secondary d-none" data-xnova-message-back>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Page précédente
        </button>
        <button type="button" class="btn btn-sm btn-link d-none" data-xnova-message-stay>Rester ici</button>
        <a class="btn btn-sm btn-primary d-none" href="#" data-xnova-message-continue>
            Continuer <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
	</div>
</div>
