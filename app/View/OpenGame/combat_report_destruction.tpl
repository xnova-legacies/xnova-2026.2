<div class="card border-0 shadow-sm mb-3 xnova-battle-destruction">
	<div class="card-header d-flex flex-wrap align-items-center gap-2 py-1 small fw-semibold">
		<i class="bi bi-moon-stars" aria-hidden="true"></i>
		<span>{destruc_title}</span>
		<span class="badge {destruc_badge} ms-auto">{destruc_result}</span>
	</div>
	<div class="card-body py-2 small">
		<p class="mb-2">{destruc_intro}</p>
		<ul class="list-unstyled mb-0">
			<li class="{destruc_chance_class}"><i class="bi bi-percent" aria-hidden="true"></i> {destruc_chance}</li>
			<li class="{destruc_rips_class}"><i class="bi bi-stars" aria-hidden="true"></i> {destruc_rips}</li>
			<li class="fw-semibold mt-2"><i class="bi bi-flag" aria-hidden="true"></i> {destruc_outcome}</li>
		</ul>
	</div>
</div>
