<div class="card xnova-panel border-0 shadow-sm mb-3">
	<div class="card-header fw-semibold">
		<i class="bi bi-award" aria-hidden="true"></i> {cred_credit}
	</div>
	<div class="card-body text-center">
		<img class="img-fluid mb-3" src="/images/xnova-wordmark.png" width="340" height="106" alt="XNova">

		<h3 class="xnova-form-section">{cred_link}</h3>
		<p class="mb-0">
			{cred_site}: <a href="https://www.xnova.fr" target="_blank" rel="noopener noreferrer">www.xnova.fr</a><br>
			{cred_forum}: <a href="https://www.xnova.fr/forum" target="_blank" rel="noopener noreferrer">www.xnova.fr/forum</a>
		</p>

		<h3 class="xnova-form-section">{cred_credit}</h3>
		<div class="table-responsive">
			<table class="table table-sm align-middle mb-0">
				<tbody>
					<tr>
						<td class="text-end fw-semibold w-50">Raito</td>
						<td class="text-start">{cred_creat} / {cred_prog}</td>
					</tr>
					<tr>
						<td class="text-end fw-semibold">Chlorel</td>
						<td class="text-start">{cred_master} {cred_prog}</td>
					</tr>
					<tr>
						<td class="text-end fw-semibold">e-Zobar</td>
						<td class="text-start">{cred_design} / {cred_prog}</td>
					</tr>
					<tr>
						<td class="text-end fw-semibold">Flousedid</td>
						<td class="text-start">{cred_web}</td>
					</tr>
					<tr>
						<td class="text-end fw-semibold">Mandalorien</td>
						<td class="text-start">{cred_prog} - version 2026</td>
					</tr>
				</tbody>
			</table>
		</div>

		<h3 class="xnova-form-section">{cred_thx}</h3>
		<div class="table-responsive">
			<table class="table table-sm align-middle mb-0">
				<tbody>
					<tr>
						<td class="text-end fw-semibold w-50">UGamela</td>
						<td class="text-start">{cred_based}</td>
					</tr>
					<tr>
						<td class="text-end fw-semibold">Britania</td>
						<td class="text-start">{cred_start}</td>
					</tr>
				</tbody>
			</table>
		</div>

		<div class="{credit_ext_class}">
			<h3 class="xnova-form-section">{cred_ext}</h3>
			<div class="table-responsive">
				<table class="table table-sm align-middle mb-0">
					<tbody>
						<tr>
							<td class="text-end fw-semibold w-50">{credit_ext_owner}</td>
							<td class="text-start">{credit_ext_funct}</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
