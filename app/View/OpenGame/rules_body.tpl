<div class="card xnova-panel border-0 shadow-sm mb-3">
	<div class="card-header fw-semibold">
		<i class="bi bi-journal-text" aria-hidden="true"></i> {rules} {servername}
	</div>
	<div class="card-body">
		<div class="alert alert-danger mb-3" role="alert">
			<i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {respectrules}
		</div>
		<div class="list-group list-group-flush">
			<a class="list-group-item list-group-item-action" href="#1">{Account}</a>
			<a class="list-group-item list-group-item-action" href="#2">{MultiAccount}</a>
			<a class="list-group-item list-group-item-action" href="#3">{Sitting}</a>
			<a class="list-group-item list-group-item-action" href="#4">{Trade}</a>
			<a class="list-group-item list-group-item-action" href="#5">{Bash}</a>
			<a class="list-group-item list-group-item-action" href="#6">{Push}</a>
			<a class="list-group-item list-group-item-action" href="#7">{Bugusing}</a>
			<a class="list-group-item list-group-item-action" href="#8">{MailIngame}</a>
			<a class="list-group-item list-group-item-action" href="#9">{OutXnova}</a>
			<a class="list-group-item list-group-item-action" href="#10">{Spam}</a>
		</div>
	</div>
</div>

<div class="card xnova-panel border-0 shadow-sm mb-3" id="1">
