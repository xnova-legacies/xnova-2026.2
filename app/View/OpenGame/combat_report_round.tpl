<div class="xnova-battle-round">
	<div class="xnova-battle-round-title"><i class="bi bi-hourglass-split" aria-hidden="true"></i> {round_title}</div>
	<div class="row g-2">
		<div class="col-12 col-lg-6">{round_attacker}</div>
		<div class="col-12 col-lg-6">{round_defender}</div>
	</div>
	<div class="xnova-battle-shots{round_waves_class}">
		<div>{round_attack_wave}</div>
		<div>{round_defend_wave}</div>
	</div>
</div>
