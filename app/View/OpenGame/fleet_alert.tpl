<div id="xnova-fleet-alert" class="xnova-alert" data-fleet-alert role="alert">
	<div class="xnova-alert-inner">
		<span class="xnova-alert-icon" aria-hidden="true"><i class="bi bi-exclamation-triangle-fill"></i></span>
		<span class="xnova-alert-title">
			{alert_title}
			<span class="xnova-alert-hint d-block">{alert_hint}</span>
		</span>
		<span class="xnova-alert-items">{alert_items}</span>
	</div>
</div>
