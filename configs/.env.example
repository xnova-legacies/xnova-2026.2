APP_ENV=local

# --- Barre de debug (php-debugbar) ---
# 1 = barre affichée en bas des pages HTML (dépendance de développement
# `composer install` requise). À laisser à 0 en production.
DEBUG_BAR=0

# --- Marché spéculatif du marchand (/game/marchand?mode=marche) ---
# Les indices suivent la rareté de chaque classe d'actifs (ressources, flottes,
# défenses) dans tout l'univers. Les relevés se déclenchent à la consultation
# (pas de tâche de fond) et la mémoire du marché est enregistrée avec eux.
MARKET_ENABLED=1
MARKET_TICK_SECONDS=300
MARKET_FEE_PERCENT=2
MARKET_HISTORY_TICKS=500
# Poids des mises des joueurs sur la cotation (0 = indices purement économiques).
MARKET_DEMAND_FACTOR=5
# Plafond de cet effet, en pourcentage (+100 = la cotation peut au plus doubler).
MARKET_DEMAND_CAP=100
# Cote horaire des ressources : écart maximal à leur taux de référence, en %
# (25 = une ressource vaut entre 0,75 et 1,25 fois son taux, chaque heure).
MARKET_RATE_AMPLITUDE=25
# Cote de rareté : écart maximal d'une part à sa moyenne, en % (+60 = ×0,625 à ×1,6).
MARKET_SCARCITY_CAP=60
# Mémoire du marché : part de l'écart rattrapée à chaque relevé, en %.
MARKET_EMA_ALPHA=10

# --- Robots autonomes ---
# Interrupteur principal : voir `CONFIG_ENABLE_BOT` (réglage `enable_bot` de la
# table `config`), plus bas. Ici, leur rythme et leur visibilité.
# Nombre de comptes robots entretenus (0 à 50) et délai minimal entre deux tours.
BOTS_COUNT=5
BOTS_TICK_SECONDS=300
# Les robots misent-ils au marché ? (1 = oui, ils font vivre la cotation).
BOTS_MARKET=1
# Interagissent-ils avec les joueurs (activité du marché, annonces, tchat) ?
# 0 = les robots continuent de jouer, mais les joueurs ne voient plus leur
# activité. L'option de compte « Voir l'activité des robots » s'y ajoute :
# l'affichage n'a lieu que si l'univers ET le joueur sont d'accord.
BOTS_INTERACTION=1

DB_HOST=db
DB_USER=xnova
DB_PASSWORD=change-me
DB_NAME=xnova
DB_PREFIX=game_
DB_ROOT_PASSWORD=change-me
MYSQL_DATABASE=xnova
MYSQL_USER=xnova
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

INSTALL_ADMIN_USER=admin
INSTALL_ADMIN_PASSWORD=change-me
INSTALL_ADMIN_EMAIL=admin@example.com
INSTALL_ADMIN_PLANET=Homeworld
INSTALL_ADMIN_SEX=

# --- Canal temps réel (service ws) ---
# Interrupteur principal : 0 = repli sur l'API JSON (aucun service ws démarré).
WS_ENABLED=1

# Mise a jour du classement (service `stats`) : intervalle en secondes entre deux
# recalculs, et interrupteur lu par deploy.ps1 (0 = le service n'est pas lance).
STATS_INTERVAL=300
STATS_ENABLED=1
WS_PORT=8081
WS_POLL_MS=3000
WS_ALLOWED_ORIGIN=
WS_APP_URL=http://app
WS_PUBLIC_URL=
# Délai maximal accordé à l'application pour répondre sur un échange relayé
# (secondes). Trop court, une écriture déjà appliquée était abandonnée : le
# navigateur recevait une erreur et n'affichait pas la nouvelle file.
WS_API_TIMEOUT=10

# --- Constantes de jeu (surcharge de includes/constants.php) ---
# Facultatives : sans elles, les valeurs par défaut du jeu s'appliquent.
# ADMIN_EMAIL=admin@xnova.fr
# UNIVERSE_GALAXIES=9
# UNIVERSE_SYSTEMS=499
# UNIVERSE_PLANETS=15
# SPY_REPORT_ROWS=2
# MOON_FIELDS_PER_LEVEL=4
# MAX_PLAYER_PLANETS=21
# MAX_BUILDING_QUEUE=5
# MAX_TECHNOLOGIE_QUEUE=10
# MAX_UNITS_PER_ROW=1000
# STORAGE_OVERFLOW=1.1
# RECORDS_SHOW_ADMINS=0
# COLONY_STORAGE=1000000
# COLONY_METAL=500
# COLONY_CRISTAL=500
# COLONY_DEUTERIUM=500

# --- Mise à jour depuis les étiquettes du dépôt Git ---
# La liste des versions disponibles, ce sont les **étiquettes** (`v2026.30`) : une
# étiquette désigne un commit, donc une version se télécharge. Le dépôt du projet est
# privé : la lecture de l'API GitHub demande un jeton, en lecture seule (« Contents:
# read » suffit). Ce fichier n'est **pas** versionné — les valeurs vivent dans
# `configs/.env.<env>`, qui est ignoré par git.
# UPDATE_REPOSITORY=mandalorien/xnova-docker
# UPDATE_TOKEN=

# --- Réglages de la table `config` ---
# Chaque réglage du jeu a une variable `CONFIG_<NOM>` (nom du réglage en
# majuscules). Elle n'est écrite qu'à l'installation : elle remplace alors la
# valeur par défaut, puis c'est la table `config` qui fait foi — le panneau
# d'administration la modifie, et une variable ajoutée après coup ne change
# jamais un réglage déjà en base (réinstaller, ou passer par /back/settings).
# Facultatives : sans elles, les valeurs par défaut ci-dessous s'appliquent.
# CONFIG_USERS_AMOUNT=0
# CONFIG_GAME_SPEED=1
# CONFIG_FLEET_SPEED=1
# CONFIG_RESOURCE_MULTIPLIER=1
# CONFIG_FLEET_CDR=30
# CONFIG_DEFS_CDR=30
# CONFIG_INITIAL_FIELDS=163
# CONFIG_COOKIE_NAME=XNova
# CONFIG_GAME_NAME=XNova
# CONFIG_GAME_DISABLE=0
# CONFIG_CLOSE_REASON=
# CONFIG_METAL_BASIC_INCOME=20
# CONFIG_CRYSTAL_BASIC_INCOME=10
# CONFIG_DEUTERIUM_BASIC_INCOME=0
# CONFIG_ENERGY_BASIC_INCOME=0
# CONFIG_BUILDLABWHILERUN=0
# CONFIG_LASTSETTEDGALAXYPOS=1
# CONFIG_LASTSETTEDSYSTEMPOS=9
# CONFIG_LASTSETTEDPLANETPOS=1
# CONFIG_VACATION_MODE_ENFORCED=1
# CONFIG_NOOBPROTECTION=1
# CONFIG_NOOBPROTECTIONTIME=5000
# CONFIG_NOOBPROTECTIONMULTI=5
# CONFIG_FORUM_URL=https://
# CONFIG_OVERVIEWNEWSFRAME=1
# CONFIG_OVERVIEWNEWSTEXT=Vous avez correctement mis votre serveur UGamela sous XNova!
# CONFIG_OVERVIEWEXTERNCHAT=0
# CONFIG_OVERVIEWEXTERNCHATCMD=
# CONFIG_OVERVIEWBANNER=0
# CONFIG_OVERVIEWCLICKBANNER=
# CONFIG_EXTCOPYFRAME=0
# CONFIG_EXTCOPYOWNER=
# CONFIG_EXTCOPYFUNCT=
# CONFIG_FORUMBANNERFRAME=0
# CONFIG_STAT_SETTINGS=1000
# CONFIG_LINK_ENABLE=0
# CONFIG_LINK_NAME=
# CONFIG_LINK_URL=
# CONFIG_BOT_NAME=XNoviana Reali
# CONFIG_BOT_ADRESS=xnova@xnova.fr
# CONFIG_BANNER_SOURCE_POST=../images/bann.png
# CONFIG_BAN_DURATION=30
# CONFIG_ENABLE_BBCODE=1
# Interrupteur des robots : le réglage `enable_bot` de la table `config`, celui
# de l'administration. À 0, aucun compte robot n'est créé et aucun tour n'est joué.
# CONFIG_ENABLE_BOT=0
# CONFIG_ENABLE_ANNOUNCES=1
# CONFIG_ENABLE_MARCHAND=1
# CONFIG_ENABLE_NOTES=1
# Affichage des erreurs PHP et constante DEBUG (0 par défaut). La barre
# php-debugbar reste réglée par DEBUG_BAR, plus haut.
# CONFIG_DEBUG=0
